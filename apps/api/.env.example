# Server Configuration
PORT=4000
NODE_ENV=development

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Database Connection (Neon PostgreSQL)
# Format: postgresql://[user]:[password]@[neon-hostname]/[dbname]?sslmode=require
DATABASE_URL="postgresql://neondb_owner:npg_sample_secret@ep-cool-sample-pooler.us-east-2.aws.neon.tech/akfa_workshop?sslmode=require"

# JWT Secret for Owner Session Auth
JWT_SECRET="akfa_workshop_jwt_secret_phase1_change_in_production"
JWT_EXPIRES_IN="7d"

# Default Workshop Owner Initial Credentials (Used during initial seeding)
INITIAL_OWNER_USERNAME="admin"
INITIAL_OWNER_PASSWORD="akfa_secure_password_2026"
INITIAL_OWNER_FULLNAME="Alisher Qodirov"
INITIAL_WORKSHOP_NAME="AKFA Rom va Eshiklar Tsexi"
INITIAL_DEFAULT_LANGUAGE="uz"
