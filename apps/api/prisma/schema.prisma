datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Owner {
  id           String         @id @default(uuid())
  username     String         @unique
  passwordHash String
  fullName     String
  workshopName String         @default("AKFA Ustaxonasi")
  language     String         @default("uz") // 'uz' | 'ru'
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions       RefreshToken[]
  voiceAuditLogs VoiceAuditLog[]

  @@map("owners")
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  ownerId   String
  owner     Owner     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([ownerId])
  @@map("refresh_tokens")
}

model Worker {
  id          String        @id @default(uuid())
  name        String
  phone       String?
  role        String        @default("usta") // 'usta' | 'shogird' | 'yordamchi' | 'ornatuvchi' | 'boshqa'
  dailyRate   Decimal       @db.Decimal(14, 2) // Daily wage rate in UZS (so'm)
  ratePerM2   Decimal       @default(0) @db.Decimal(14, 2) // Price per square meter in UZS (so'm)
  status      String        @default("ACTIVE") // 'ACTIVE' | 'ARCHIVED'
  archivedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  attendances Attendance[]
  payments    Payment[]
  volumes     VolumeRecord[]

  @@index([status])
  @@map("workers")
}

model Attendance {
  id           String   @id @default(uuid())
  workerId     String
  worker       Worker   @relation(fields: [workerId], references: [id], onDelete: Restrict)
  date         String   // ISO YYYY-MM-DD format
  status       String   @default("PRESENT") // 'PRESENT' | 'ABSENT'
  rateSnapshot Decimal  @db.Decimal(14, 2) // Historical snapshot of daily rate on attendance date
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([workerId, date])
  @@index([date])
  @@index([workerId])
  @@map("attendances")
}

model Payment {
  id            String   @id @default(uuid())
  workerId      String
  worker        Worker   @relation(fields: [workerId], references: [id], onDelete: Restrict)
  amount        Decimal  @db.Decimal(14, 2) // Decimal-safe monetary arithmetic, partial & full
  paymentDate   String   // ISO YYYY-MM-DD format
  paymentMethod String   @default("CASH") // 'CASH' | 'CARD' | 'BANK_TRANSFER'
  notes         String?
  createdAt     DateTime @default(now())

  @@index([workerId])
  @@index([paymentDate])
  @@map("payments")
}

model VolumeRecord {
  id           String   @id @default(uuid())
  workerId     String
  worker       Worker   @relation(fields: [workerId], references: [id], onDelete: Restrict)
  date         String   // ISO YYYY-MM-DD format
  squareMeters Decimal  @db.Decimal(10, 2) // Completed m² (e.g. 14.50)
  rateSnapshot Decimal  @db.Decimal(14, 2) // Snapshot of rate per m² at recording time
  totalAmount  Decimal  @db.Decimal(14, 2) // Automatically calculated: squareMeters * rateSnapshot
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([workerId])
  @@index([date])
  @@map("volume_records")
}

model VoiceAuditLog {
  id                 String    @id @default(uuid())
  ownerId            String
  owner              Owner     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  transcript         String
  intent             String
  status             String    // 'PENDING_CONFIRMATION' | 'CONFIRMED' | 'REJECTED' | 'READ_ONLY' | 'FAILED'
  payload            Json
  resultSummary      String?
  confirmationToken  String?   @unique
  expiresAt          DateTime?
  confirmedAt        DateTime?
  createdAt          DateTime  @default(now())

  @@index([ownerId])
  @@index([confirmationToken])
  @@index([createdAt])
  @@map("voice_audit_logs")
}
