# =============================================================================
# Root & Shared Environment Template for AKFA Workshop Management
# Duplicate to .env or inject into CI/CD / Vercel / Render deployment platforms.
# =============================================================================

# Server API Configuration
PORT=4000
NODE_ENV=development

# Web Frontend Configuration
VITE_API_URL=http://localhost:4000/api
VITE_DEFAULT_LANGUAGE=uz

# Production Database (Neon PostgreSQL connection string)
DATABASE_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD_HERE@ep-cool-sample.us-east-2.aws.neon.tech/akfa_workshop?sslmode=require"

# JWT Secret for Session Authentication
JWT_SECRET="replace_with_a_secure_random_64_character_hex_string"
JWT_EXPIRES_IN="7d"

# Default Workshop Owner Settings
INITIAL_OWNER_USERNAME="admin"
INITIAL_OWNER_PASSWORD="akfa_secure_password_2026"
INITIAL_OWNER_FULLNAME="Alisher Qodirov"
INITIAL_WORKSHOP_NAME="AKFA Rom va Eshiklar Tsexi"
