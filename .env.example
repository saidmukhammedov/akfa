# =============================================================================
# Root & Shared Environment Template for AKFA Workshop Management (Phase 2)
# =============================================================================

# Server API Configuration
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Frontend Web Configuration
VITE_API_URL=http://localhost:4000/api
VITE_DEFAULT_LANGUAGE=uz

# Production Database (Neon PostgreSQL connection strings)
# DATABASE_URL: Pooled connection string (uses pgbouncer / Neon pooler)
DATABASE_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD_HERE@ep-sample-pooler.us-east-2.aws.neon.tech/akfa_workshop?sslmode=require"
# DIRECT_URL: Direct non-pooled connection string (required for Prisma migrations on Neon)
DIRECT_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD_HERE@ep-sample.us-east-2.aws.neon.tech/akfa_workshop?sslmode=require"

# Test Database Connection (Used for isolated automated test runs)
TEST_DATABASE_URL="postgresql://postgres:YOUR_LOCAL_OR_CI_PASSWORD@localhost:5432/akfa_workshop_test?schema=public"

# JWT Authentication Secrets
JWT_SECRET="replace_with_a_secure_random_64_character_hex_string"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_DAYS=7

# Default Workshop Owner Initial Credentials (Used during initial seeding)
INITIAL_OWNER_USERNAME="admin"
INITIAL_OWNER_PASSWORD="akfa_secure_password_2026"
INITIAL_OWNER_FULLNAME="Alisher Qodirov"
INITIAL_WORKSHOP_NAME="AKFA Rom va Eshiklar Tsexi"
INITIAL_DEFAULT_LANGUAGE="uz"
