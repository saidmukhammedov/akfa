{
  "name": "akfa-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "AKFA workshop management system - Phase 2 Monorepo",
  "scripts": {
    "build:shared": "pnpm --filter @akfa/shared build",
    "build": "pnpm --filter @akfa/shared build && pnpm --filter @akfa/api build && pnpm --filter @akfa/web build",
    "dev:shared": "pnpm --filter @akfa/shared dev",
    "dev:web": "pnpm --filter @akfa/web dev",
    "dev:api": "pnpm --filter @akfa/api dev",
    "dev": "pnpm --filter @akfa/shared build && pnpm --parallel --filter @akfa/api --filter @akfa/web dev",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "prisma:generate": "pnpm --filter @akfa/api prisma:generate",
    "prisma:migrate": "pnpm --filter @akfa/api prisma:migrate",
    "prisma:deploy": "pnpm --filter @akfa/api prisma:deploy",
    "admin:reset": "node scripts/admin-reset-owner.mjs"
  },
  "packageManager": "pnpm@12.15.0",
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
